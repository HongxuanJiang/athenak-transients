# The Brio & Wu (1988) shock tube at a tenth of its gas pressure, with the dual-energy
# formalism on at its default thresholds.  The right state has beta = 0.013 and the gas
# behind the slow shock starts below 0.1*B^2/2, where the energy channel is otherwise
# rejected as magnetic truncation error: only the shock detector keeps its heating.

<comment>
problem   = low-beta Brio & Wu shock tube, dual energy
reference = Brio, M. & Wu, C.C., JCP 75, 400 (1988)

<job>
basename  = bw_lowbeta_dual

<mesh>
nghost    = 2
nx1       = 256
x1min     = -0.5
x1max     = 0.5
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 1
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 256
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.8
nlim       = -1
tlim       = 0.1
ndiag      = 1

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = hlld
gamma       = 2.0
dual_energy = true
dual_energy_eta1 = 1.0e-3
dual_energy_eta2 = 1.0e-1

<problem>
pgen_name = shock_tube
shock_dir = 1
xshock    = 0.0
dl  = 1.0
pl  = 0.1
ul  = 0.0
vl  = 0.0
wl  = 0.0
bxl = 0.75
byl = 1.0
bzl = 0.0
dr  = 0.125
pr  = 0.01
ur  = 0.0
vr  = 0.0
wr  = 0.0
bxr = 0.75
byr = -1.0
bzr = 0.0

<output1>
file_type   = tab
variable    = mhd_w
data_format = %24.16e
dt          = 0.1
