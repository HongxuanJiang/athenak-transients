<comment>
problem   = Uniform GR MHD box relaxed by Noble disk cooling, dual-energy auxiliary on

<job>
basename  = dual_gr_cooling

<mesh>
nghost    = 2
nx1       = 32
x1min     = 0.49
x1max     = 0.51
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 1
x2min     = -0.01
x2max     = 0.01
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = -0.01
x3max     = 0.01
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 32
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 0.2
ndiag      = 1000

<coord>
general_rel = true
minkowski   = true

<mhd>
eos              = ideal
reconstruct      = plm
rsolver          = hlle
gamma            = 2.0
dfloor           = 1.0e-10
pfloor           = 1.0e-10
dual_energy      = true
dual_energy_eta1 = 1.0e-4
dual_energy_eta2 = 1.0e30

<mhd_srcterms>
disk_cooling            = true
disk_cooling_h_over_r   = 0.0707106781
disk_cooling_noble_s    = 3.0
disk_cooling_noble_q    = 0.5

<problem>
pgen_name  = shock_tube
shock_dir  = 1
xshock     = 0.5

dl  = 1.0
pl  = 1.0
ul  = 0.0
vl  = 0.0
wl  = 0.0
bxl = 0.1
byl = 0.0
bzl = 0.0

dr  = 1.0
pr  = 1.0
ur  = 0.0
vr  = 0.0
wr  = 0.0
bxr = 0.1
byr = 0.0
bzr = 0.0

<output1>
file_type   = tab
variable    = mhd_w
data_format = %24.16e
dt          = 0.2
slice_x2    = 0.0
slice_x3    = 0.0
