<job>
basename = srmhd_hlld_face

<mesh>
nghost = 2
nx1 = 8
x1min = -0.5
x1max = 0.5
ix1_bc = outflow
ox1_bc = outflow
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 1
nx3 = 1

<coord>
special_rel = true

<time>
evolution = dynamic
integrator = rk1
cfl_number = 0.1
nlim = 1
tlim = 10.0

<mhd>
eos = ideal
reconstruct = dc
rsolver = hlld
gamma = 1.3333333333333333
dfloor = 1.0e-30
pfloor = 1.0e-30

<problem>
pgen_name = shock_tube
shock_dir = 1
xshock = 0.0
dl = 1.0
pl = 1.0
ul = 0.0
vl = 0.0
wl = 0.0
bxl = 0.0
byl = 1.0
bzl = 0.0
dr = 1.0
pr = 1.0
ur = 0.0
vr = 0.0
wr = 0.0
bxr = 0.0
byr = 1.0
bzr = 0.0

<output1>
file_type = bin
variable = mhd_u
variable_precision = float64
dcycle = 1
