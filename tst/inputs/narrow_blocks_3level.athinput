<job>
basename = narrow3level

<mesh>
nghost = 4
nx1 = 32
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 32
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 4
nx2 = 4
nx3 = 1

<mesh_refinement>
refinement = static

<refined_region0>
level = 1
x1min = 0.375
x1max = 0.625
x2min = 0.375
x2max = 0.625
x3min = 0.0
x3max = 1.0

<refined_region1>
level = 2
x1min = 0.4375
x1max = 0.5625
x2min = 0.4375
x2max = 0.5625
x3min = 0.0
x3max = 1.0

<time>
evolution = dynamic
integrator = rk1
cfl_number = 0.3
nlim = 4
tlim = 1.0

<mhd>
eos = ideal
reconstruct = wenoz
rsolver = hlld
gamma = 1.6666666666666667

<problem>
pgen_name = linear_wave
wave_flag = 0
amp = 1.0e-3
dens = 1.0
pgas = 0.6
vx0 = 0.0
bx0 = 1.0
by0 = 1.4142135623730951
bz0 = 0.5
along_x1 = false

<output1>
file_type = bin
variable = mhd_u
ghost_zones = true
variable_precision = float64
dcycle = 1

<output2>
file_type = bin
variable = mhd_bcc
ghost_zones = true
variable_precision = float64
dcycle = 1

<output3>
file_type = rst
dcycle = 2
