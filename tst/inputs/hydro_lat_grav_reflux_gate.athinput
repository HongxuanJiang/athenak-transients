# AthenaK regression input for the LAT window-end gravitational-work refund gate.

<comment>
problem = dense gas venting across a coarse/fine face into an ambient below rho_grav_min

<job>
basename = HydroLATGravRefluxGate

<mesh>
nghost = 2
nx1 = 32
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic

nx2 = 8
x2min = -0.125
x2max = 0.125
ix2_bc = periodic
ox2_bc = periodic

nx3 = 8
x3min = -0.125
x3max = 0.125
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<mesh_refinement>
refinement = static
max_nmb_per_rank = 128

<refined_region0>
level = 1
x1min = 0.0
x1max = 0.25
x2min = -0.125
x2max = 0.125
x3min = -0.125
x3max = 0.125

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = -1
tlim = 0.02
ndiag = 1000
lat = true
lat_levels = 2
lat_same_level = true
lat_same_level_max_ratio = 4
hydro_lat_min_bin_count = 0

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.4
dfloor = 1.0e-16
pfloor = 1.0e-18

<hydro_srcterms>
self_gravity = true

<gravity>
four_pi_G = 100.0
threshold = 1.0e-8
niteration = -1
npresmooth = 2
npostsmooth = 2
full_multigrid = true
fmg_ncycle = 1
show_defect = false
mg_nghost = 1
root_on_host = false
rho_grav_min = 1.0e-15
solve_dt = 0.01

<problem>
pgen_name = shock_tube
shock_dir = 1
xshock = 0.0
dl = 1.0e-16
pl = 1.0e-18
ul = 0.0
vl = 0.0
wl = 0.0
dr = 1.0
pr = 1.0
ur = 0.0
vr = 0.0
wr = 0.0

<output1>
file_type = hst
dt = 1.0e-8
data_format = %24.16e

<output2>
file_type = bin
variable = hydro_u
dt = 1.0e-8
variable_precision = float64
