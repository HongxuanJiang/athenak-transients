# A short 2D hydro linear wave on an adaptive mesh, with a checkpoint every cycle.
# Used by tst/test_suite/nr/test_nr_amr_restart_bitwise_mpicpu.py: a checkpoint is
# written before its own cycle's AMR pass, so a restart has to repeat that pass.
# refinement_interval = ncycle_check keeps the per-MeshBlock refinement cooldown
# inert, which is what lets the restart be bitwise rather than merely close.

<comment>
problem   = hydro linear wave, adaptive mesh, restart regression

<job>
basename  = LinWaveAMRRestart

<mesh>
nghost    = 2
nx1       = 64
x1min     = 0.0
x1max     = 3.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 32
x2min     = 0.0
x2max     = 1.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = 0.0
x3max     = 1.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 1

<mesh_refinement>
refinement          = adaptive
max_nmb_per_rank    = 256
num_levels          = 2
ncycle_check        = 1
refinement_interval = 1

<amr_criterion0>
method    = min_max
variable  = hydro_w_d
value_max = 1.0008

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 12
tlim       = 5.0
ndiag      = 1

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.66666666667

<problem>
pgen_name = linear_wave
wave_flag = 0
amp       = 1.0e-3
dens      = 1.0
pgas      = 0.6
vx0       = 0.0
along_x1  = false
along_x2  = false
along_x3  = false

<output1>
file_type   = hst
data_format = %24.16e
dt          = 1.0e-8

<output2>
file_type   = rst
dcycle      = 1
